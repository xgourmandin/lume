@baseUrl = http://localhost:3000

### GET Health check
GET {{baseUrl}}/health

// ─────────────────────────────────────────
// Hierarchy
// ─────────────────────────────────────────

### GET Get the merged GCP hierarchy
GET {{baseUrl}}/api/v1/hierarchy

### POST Sync hierarchy from a GCS state file
POST {{baseUrl}}/api/v1/hierarchy/sync
Content-Type: application/json

{
  "layer_id": "apps",
  "tf_workspace_id": "prod",
  "bucket": "my-tf-states",
  "object": "apps/prod.tfstate"
}

### POST Sync hierarchy – defaults (omitted IDs fall back to "default")
POST {{baseUrl}}/api/v1/hierarchy/sync
Content-Type: application/json

{
  "bucket": "my-tf-states",
  "object": "default.tfstate"
}

###
// ─────────────────────────────────────────
// Drift reports
// ─────────────────────────────────────────

### GET Get the latest drift result for a (layer, tf-workspace) tuple
GET {{baseUrl}}/api/v1/drift/apps/prod

### POST Report drift – upload a tofu plan JSON file (multipart/form-data)
# Generate the plan file with: tofu plan -out=plan.tfplan && tofu show -json plan.tfplan > plan.json
POST {{baseUrl}}/api/v1/drift/apps/prod
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="plan"; filename="plan.json"
Content-Type: application/json

< ./plan.json
--boundary--

###
// ─────────────────────────────────────────
// Webhooks – Git
// ─────────────────────────────────────────

### POST Git webhook – explicit layer / tf-workspace
POST {{baseUrl}}/api/v1/webhooks/git
Content-Type: application/json

{
  "layer_id": "network",
  "tf_workspace_id": "prod",
  "bucket": "my-tf-states",
  "object": "network/prod.tfstate"
}

### POST Git webhook – minimal body (layer + tf_workspace default to "default")
POST {{baseUrl}}/api/v1/webhooks/git
Content-Type: application/json

{
  "bucket": "my-tf-states",
  "object": "default.tfstate"
}

###
// ─────────────────────────────────────────
// Webhooks – GCS (Pub/Sub push)
// message.data is base64( {"bucket":"my-tf-states","name":"apps/prod.tfstate","eventType":"OBJECT_FINALIZE"} )
// ─────────────────────────────────────────

### POST GCS notification – OBJECT_FINALIZE → triggers sync
POST {{baseUrl}}/api/v1/webhooks/gcs
Content-Type: application/json

{
  "message": {
    "data": "eyJidWNrZXQiOiJteS10Zi1zdGF0ZXMiLCJuYW1lIjoiYXBwcy9wcm9kLnRmc3RhdGUiLCJldmVudFR5cGUiOiJPQkpFQ1RfRklOQUxJWkUifQ=="
  }
}

###
// message.data is base64( {"bucket":"my-tf-states","name":"apps/prod.tfstate","eventType":"OBJECT_DELETE"} )
### POST GCS notification – OBJECT_DELETE → ignored (200 {"status":"ignored"})
POST {{baseUrl}}/api/v1/webhooks/gcs
Content-Type: application/json

{
  "message": {
    "data": "eyJidWNrZXQiOiJteS10Zi1zdGF0ZXMiLCJuYW1lIjoiYXBwcy9wcm9kLnRmc3RhdGUiLCJldmVudFR5cGUiOiJPQkpFQ1RfREVMRVRFIn0="
  }
}

###
// message.data is base64( {"bucket":"my-tf-states","name":"apps/plan.out","eventType":"OBJECT_FINALIZE"} )
### POST GCS notification – non-.tfstate file → ignored (200 {"status":"ignored"})
POST {{baseUrl}}/api/v1/webhooks/gcs
Content-Type: application/json

{
  "message": {
    "data": "eyJidWNrZXQiOiJteS10Zi1zdGF0ZXMiLCJuYW1lIjoiYXBwcy9wbGFuLm91dCIsImV2ZW50VHlwZSI6Ik9CSkVDVF9GSU5BTElaRSJ9"
  }
}
