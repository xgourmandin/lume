# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM golang:1.25 AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags="-s -w" \
    -o /drift-scanner \
    ./cmd/drift-scanner

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
FROM ubuntu:24.04

ARG TOFU_VERSION=1.9.0

# git: required for CloneLayer
# curl + unzip + ca-certificates: required to download and verify OpenTofu
RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        curl \
        unzip \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install OpenTofu — the binary is the only file inside the zip.
RUN curl -fsSL \
        -o /tmp/tofu.zip \
        "https://github.com/opentofu/opentofu/releases/download/v${TOFU_VERSION}/tofu_${TOFU_VERSION}_linux_amd64.zip" \
    && unzip /tmp/tofu.zip tofu -d /usr/local/bin/ \
    && chmod +x /usr/local/bin/tofu \
    && rm /tmp/tofu.zip \
    && tofu version   # smoke-test

COPY --from=builder /drift-scanner /drift-scanner

# Cloud Run Jobs run as non-root by default; ensure the binary is executable.
RUN chmod +x /drift-scanner

ENTRYPOINT ["/drift-scanner"]

